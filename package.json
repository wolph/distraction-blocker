{
  "dependencies": {
    "preact": "10.23.2",
    "tldts": "6.1.44"
  },
  "description": "Focus Lock: focus sessions that lock distracting sites, with earned pauses.",
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@crxjs/vite-plugin": "2.0.0-beta.25",
    "@playwright/test": "1.47.0",
    "@preact/preset-vite": "2.9.0",
    "@types/chrome": "0.0.270",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "typescript": "5.6.2",
    "vite": "5.4.3",
    "vitest": "2.0.5"
  },
  "license": "UNLICENSED",
  "name": "distraction-blocker",
  "private": true,
  "scripts": {
    "build": "vite build",
    "check": "biome check . && tsc --noEmit && vitest run && vite build",
    "dev": "vite",
