{
  "dependencies": {
    "preact": "10.26.9",
    "tldts": "7.0.10"
  },
  "description": "Focus Lock: focus sessions that lock distracting sites, with earned pauses.",
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@crxjs/vite-plugin": "2.0.2",
    "@playwright/test": "1.53.2",
    "@preact/preset-vite": "2.10.2",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/preact": "3.2.4",
    "@types/chrome": "0.0.329",
    "@types/pngjs": "6.0.5",
    "html-validate": "9.7.1",
    "jsdom": "26.1.0",
    "pngjs": "7.0.0",
    "typescript": "5.8.3",
    "vite": "7.0.2",
    "vitest": "3.2.4",
    "yaml": "2.8.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "license": "UNLICENSED",
  "name": "distraction-blocker",
  "private": true,
  "scripts": {
    "build": "npm run gen-icons && vite build",
    "check": "biome check . && tsc --noEmit && vitest run && npm run build",
    "dev": "vite",
    "e2e": "npm run build && playwright test",
    "format": "biome check --write .",
    "gen-icons": "node scripts/gen-icons.mjs",
    "lint": "biome check .",
    "pages:build": "node scripts/build-pages.mjs",
    "pages:validate": "node scripts/validate-pages.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0"
}
