{
  "dependencies": {
    "preact": "10.24.0",
    "tldts": "6.1.46"
  },
  "description": "Focus Lock: focus sessions that lock distracting sites, with earned site access credit.",
  "devDependencies": {
    "@biomejs/biome": "1.9.1",
    "@crxjs/vite-plugin": "2.0.0-beta.25",
    "@playwright/test": "1.47.1",
    "@preact/preset-vite": "2.9.1",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/preact": "3.2.4",
    "@types/chrome": "0.0.271",
    "@types/pngjs": "6.0.5",
    "jsdom": "25.0.0",
    "pngjs": "7.0.0",
    "typescript": "5.6.2",
    "vite": "5.4.6",
    "vitest": "2.1.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "license": "UNLICENSED",
  "name": "distraction-blocker",
  "private": true,
  "scripts": {
    "build": "npm run gen-icons && vite build",
    "check": "biome check . && tsc --noEmit && vitest run && npm run build",
    "dev": "vite",
    "e2e": "npm run build && playwright test",
    "format": "biome check --write .",
    "gen-icons": "node scripts/gen-icons.mjs",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0"
}
